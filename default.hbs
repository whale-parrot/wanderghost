<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <script>
        // Runs immediately to set theme before page paints
        (function() {
            const theme = localStorage.getItem('wanderghost-theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

            if (theme === 'dark' || (theme === 'system' && prefersDark)) {
                document.documentElement.setAttribute('data-theme', 'dark');
            } else if (theme === 'light') {
                document.documentElement.setAttribute('data-theme', 'light');
            } else {
                document.documentElement.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
                localStorage.setItem('wanderghost-theme', 'system');
            }
        })();
    </script>

    <link rel="stylesheet" href="{{asset "built/index.css"}}" />
    <script src="{{asset "built/index.js"}}" defer></script>

    <title>{{meta_title}}</title>

    {{ghost_head}}
    
    <!-- Leaflet Core CSS (Official SRI hash from leafletjs.com) -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    
    <!-- MarkerCluster CSS (No hash to prevent silent CDN blocking) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet.markercluster/1.5.3/MarkerCluster.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet.markercluster/1.5.3/MarkerCluster.Default.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css">
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/fill/style.css">
</head>
<body class="{{body_class}}">
<div class="gh-viewport">

<header id="gh-head" class="gh-head">
    <nav class="gh-head-inner gh-container">
        <div class="gh-head-brand">
            <a class="gh-head-logo" href="{{@site.url}}">
                {{#if @site.logo}}
                    <img src="{{@site.logo}}" alt="{{@site.title}}" />
                {{else}}
                    {{@site.title}}
                {{/if}}
            </a>
            <a class="gh-burger" role="button" aria-label="menu">
                <div class="gh-burger-box">
                    <div class="gh-burger-inner"></div>
                </div>
            </a>
        </div>
        <div class="gh-head-menu">
            {{navigation}}
        </div>
        <div class="gh-head-actions">
            <div class="gh-head-actions-list">
                {{search}}
                {{#if @site.members_enabled}}
                    {{^if @member}}
                    <a class="gh-button" href="{{@site.signup_url}}">Subscribe here</a>
                    {{else}}
                    <a class="gh-button" href="#/portal/account">Account</a>
                    {{/if}}
                {{/if}}
                
                <!-- Theme Toggle Buttons -->
                <div class="theme-toggle" aria-label="Theme switcher">
                    <button class="theme-toggle-btn" data-theme="light" title="Light mode">
                        <i class="ph-fill ph-sun"></i>
                    </button>
                    <button class="theme-toggle-btn" data-theme="system" title="System preference">
                        <i class="ph-fill ph-monitor"></i>
                    </button>
                    <button class="theme-toggle-btn" data-theme="dark" title="Dark mode">
                        <i class="ph-fill ph-moon"></i>
                    </button>
                </div>
            </div>
        </div>
    </nav>
</header>

<main class="gh-main">
    {{{body}}}
</main>

<footer class="gh-foot">
    <div class="gh-container">
        <div class="gh-foot-menu">
            {{navigation type="secondary"}}
        </div>
        <!--<div class="gh-foot-meta">
            Published with <a href="https://ghost.org" target="_blank" rel="noopener">Ghost</a>
        </div>-->
    </div>
</footer>

</div>

{{ghost_foot}}

<!-- Leaflet Core JS (Official SRI hash from leafletjs.com) -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<!-- MarkerCluster JS (No hash to prevent silent CDN blocking) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet.markercluster/1.5.3/leaflet.markercluster.min.js"></script>

<!-- Our Custom Map Loaders -->
<script src="{{asset "js/map-common.js"}}"></script>
<script src="{{asset "js/map-loader.js"}}"></script>
<script src="{{asset "js/global-map.js"}}"></script>

<script>
    // comments-ui reads the color scheme once at mount and only re-checks it
    // when the parent of #ghost-comments-root changes class or style.
    // Toggling data-theme on <html> alone is invisible to it, so change this
    // class whenever the theme changes.
    function syncCommentsColorScheme(actualTheme) {
        document.querySelectorAll('.gh-post-comments').forEach((el) => {
            el.classList.toggle('gh-comments-dark', actualTheme === 'dark');

            // comments-ui renders inside a same-origin srcdoc iframe. Its
            // document has a white canvas by default, which hides the page
            // background and makes dark-mode (white) text invisible. Make the
            // iframe document transparent and match its color-scheme.
            el.querySelectorAll('iframe').forEach((frame) => {
                styleCommentsFrame(frame, actualTheme);
            });
        });
    }

    function styleCommentsFrame(frame, actualTheme) {
        try {
            const doc = frame.contentDocument;
            if (!doc) return;
            doc.documentElement.style.backgroundColor = 'transparent';
            doc.documentElement.style.colorScheme = actualTheme;
            if (doc.body) {
                doc.body.style.backgroundColor = 'transparent';
            }

            // comments-ui's CTA and links use fixed black colors, which
            // disappear on a dark page. Match them to the theme in dark mode.
            let style = doc.getElementById('wanderghost-comments-theme');
            if (!style) {
                style = doc.createElement('style');
                style.id = 'wanderghost-comments-theme';
                (doc.head || doc.documentElement).appendChild(style);
            }

            if (actualTheme === 'dark') {
                const accent = getComputedStyle(document.documentElement)
                    .getPropertyValue('--color-primary').trim() || '#C4BBD8';
                const text = getComputedStyle(document.body).color;
                style.textContent = `
                    .ghost-display { --gh-accent-color: ${accent} !important; }
                    .ghost-display.dark button { color: ${text} !important; }
                `;
            } else {
                style.textContent = '';
            }
        } catch (e) {
            // Cross-origin comments iframe; nothing we can style from here.
        }
    }

    // comments-ui creates its iframe after DOMContentLoaded, so watch for it.
    function watchCommentsFrames() {
        document.querySelectorAll('.gh-post-comments').forEach((section) => {
            const apply = () => syncCommentsColorScheme(
                document.documentElement.getAttribute('data-theme')
            );

            section.querySelectorAll('iframe').forEach((frame) => {
                frame.addEventListener('load', apply);
            });
            apply();

            new MutationObserver((mutations) => {
                mutations.forEach((mutation) => {
                    mutation.addedNodes.forEach((node) => {
                        if (node.nodeType !== 1) return;
                        if (node.tagName === 'IFRAME') {
                            node.addEventListener('load', apply);
                        } else if (node.querySelectorAll) {
                            node.querySelectorAll('iframe').forEach((frame) => {
                                frame.addEventListener('load', apply);
                            });
                        }
                    });
                });
                apply();
            }).observe(section, { childList: true, subtree: true });
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        const buttons = document.querySelectorAll('.theme-toggle-btn');
        const currentTheme = localStorage.getItem('wanderghost-theme') || 'system';

        // Keep comments in sync on first load as well
        watchCommentsFrames();

        // Set initial active state
        buttons.forEach(btn => {
            if (btn.dataset.theme === currentTheme) {
                btn.classList.add('active');
            }
        });

        // Handle clicks
        buttons.forEach(btn => {
            btn.addEventListener('click', () => {
                const theme = btn.dataset.theme;
                const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                let actualTheme;

                if (theme === 'system') {
                    actualTheme = prefersDark ? 'dark' : 'light';
                } else {
                    actualTheme = theme;
                }

                document.documentElement.setAttribute('data-theme', actualTheme);
                localStorage.setItem('wanderghost-theme', theme);

                buttons.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');

                // Make comments-ui re-evaluate its light/dark mode first
                syncCommentsColorScheme(actualTheme);

                if (typeof window.updateWanderGhostMapTheme === 'function') {
                    window.updateWanderGhostMapTheme(actualTheme);
                }
                if (typeof window.updateWanderGhostPostMapTheme === 'function') {
                    window.updateWanderGhostPostMapTheme(actualTheme);
                }
            });
        });
    });
</script>


</body>
</html>