{
    "name": "wanderghost",
    "description": "A custom mobile-first travel theme for Ghost with auto-mapping",
    "demo": "https://starter.ghost.io",
    "version": "0.1.0",
    "engines": {
        "ghost": ">=5.0.0"
    },
    "license": "MIT",
    "screenshots": {
        "desktop": "assets/screenshot-desktop.jpg"
    },
    "scripts": {
        "dev": "rollup -c --environment BUILD:development -w",
        "build": "rollup -c --environment BUILD:production",
        "zip": "pnpm build && bestzip $npm_package_name.zip assets/* partials/* members/* *.hbs package.json",
        "test": "gscan .",
        "pretest": "pnpm zip",
        "test:ci": "gscan --fatal --verbose .",
        "pretest:ci": "pnpm zip"
    },
    "packageManager": "pnpm@12.14.0",
    "author": {
        "name": "Quirin",
        "email": "your-email@example.com",
        "url": "https://github.com/whale-parrot"
    },
    "gpm": {
        "type": "theme",
        "categories": [
            "Minimal",
            "Travel",
            "Photography"
        ]
    },
    "keywords": [
        "ghost",
        "theme",
        "ghost-theme",
        "travel",
        "mobile-first",
        "maps"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/whale-parrot/wanderghost.git"
    },
    "bugs": "https://github.com/whale-parrot/wanderghost/issues",
    "contributors": "https://github.com/whale-parrot/wanderghost/graphs/contributors",
    "devDependencies": {
        "@babel/core": "8.0.7",
        "@babel/preset-env": "8.0.7",
        "@rollup/plugin-babel": "7.1.0",
        "@rollup/plugin-commonjs": "29.0.3",
        "@rollup/plugin-node-resolve": "16.0.3",
        "@rollup/plugin-terser": "1.0.0",
        "bestzip": "4.0.3",
        "gscan": "6.6.1",
        "postcss": "8.5.30",
        "postcss-import": "17.0.1",
        "postcss-preset-env": "11.6.1",
        "rollup": "4.64.9",
        "rollup-plugin-livereload": "2.0.5",
        "rollup-plugin-postcss": "4.0.2"
    },
    "browserslist": [
        "defaults"
    ],
    "config": {
        "card_assets": true,
        "posts_per_page": 15,
        "image_sizes": {
            "xxs": {
                "width": 30
            },
            "xs": {
                "width": 100
            },
            "s": {
                "width": 300
            },
            "m": {
                "width": 600
            },
            "l": {
                "width": 1200
            },
            "xl": {
                "width": 2000
            }
        }
    },
    "type": "module"
}