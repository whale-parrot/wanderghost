{{!< default}}

<main class="gh-main global-map-wrapper">
    {{!-- The map container --}}
    <div id="global-travel-map" style="width: 100%; height: 100%; z-index: 1;"></div>
</main>

<style>
    /* 1. Target the main viewport wrapper and turn it into a vertical Flex container */
    body.page-travel-map .gh-viewport {
        display: flex !important;
        flex-direction: column !important;
        height: 100vh !important; /* Locks the whole page to exactly 1 screen height */
        overflow: hidden !important; /* Prevents any scrolling */
    }

    /* 2. Tell the header to only take up the space it naturally needs */
    body.page-travel-map .gh-head {
        flex-shrink: 0 !important; 
    }

    /* 3. Tell the map wrapper to expand and fill ALL remaining vertical space */
    body.page-travel-map .gh-main.global-map-wrapper {
        flex: 1 !important; /* This is the magic: it takes up the rest of the space */
        height: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
        max-width: 100% !important;
    }

    /* 4. Hide the footer to maximize map space */
    body.page-travel-map .gh-foot {
        display: none !important; 
    }

    /* 5. Custom styling for the map popups */
    .wanderghost-popup img {
        width: 100%;
        height: 120px;
        object-fit: cover;
        border-radius: 4px;
        margin-bottom: 8px;
    }
    .wanderghost-popup h3 {
        margin: 0 0 4px 0;
        font-size: 16px;
    }
    .wanderghost-popup a {
        font-size: 14px;
        text-decoration: none;
        font-weight: bold;
    }
</style>